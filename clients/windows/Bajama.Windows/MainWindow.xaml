<Window x:Class="Bajama.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BAJAMA" Height="820" Width="1360" MinHeight="650" MinWidth="960"
        WindowStartupLocation="CenterScreen" Background="{StaticResource CanvasBrush}">
    <Grid>
        <Grid x:Name="LoginPanel" Visibility="Visible">
            <Border Width="470" Padding="38" Background="White" CornerRadius="22"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect><DropShadowEffect BlurRadius="32" ShadowDepth="4" Opacity="0.12" /></Border.Effect>
                <StackPanel>
                    <Border Width="52" Height="52" CornerRadius="16" Background="#EEF2FF" HorizontalAlignment="Left">
                        <TextBlock Text="B" Foreground="{StaticResource BrandBrush}" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="BAJAMA" FontSize="28" FontWeight="Bold" Foreground="{StaticResource InkBrush}" Margin="0,22,0,4" />
                    <TextBlock Text="Masuk ke ruang kerja operasional Anda" FontSize="14" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,26" />
                    <TextBlock Text="Alamat server" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" Margin="0,0,0,7" />
                    <TextBox x:Name="ApiUrlBox" Text="https://bajama.example.com/" Padding="12" FontSize="14" Margin="0,0,0,15" />
                    <TextBlock Text="Username atau email" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" Margin="0,0,0,7" />
                    <TextBox x:Name="UsernameBox" Padding="12" FontSize="14" Margin="0,0,0,15" />
                    <TextBlock Text="Password" FontWeight="SemiBold" Foreground="{StaticResource InkBrush}" Margin="0,0,0,7" />
                    <PasswordBox x:Name="PasswordBox" Padding="12" FontSize="14" Margin="0,0,0,18" />
                    <Button x:Name="LoginButton" Content="Masuk ke BAJAMA" Click="LoginButton_Click"
                            Background="{StaticResource BrandBrush}" Foreground="White" BorderThickness="0" Height="46" />
                    <TextBlock x:Name="LoginMessage" TextWrapping="Wrap" Foreground="#DC2626" Margin="0,13,0,0" />
                    <TextBlock Text="Koneksi terenkripsi HTTPS • Token akses sementara" FontSize="11" Foreground="#94A3B8" Margin="0,21,0,0" />
                </StackPanel>
            </Border>
        </Grid>

        <Grid x:Name="ShellPanel" Visibility="Collapsed">
            <Grid.ColumnDefinitions><ColumnDefinition Width="252" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="#111827">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="20,24,20,22">
                        <TextBlock Text="BAJAMA" FontSize="21" FontWeight="Bold" Foreground="White" />
                        <TextBlock Text="ISP OPERATIONS" FontSize="10" Foreground="#94A3B8" Margin="0,3,0,0" />
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Bottom" Margin="15">
                        <TextBlock x:Name="ConnectionStatus" Text="● Online" Foreground="#34D399" Margin="10,0,0,13" />
                        <Button Content="Keluar" Click="LogoutButton_Click" HorizontalContentAlignment="Left"
                                Background="#1F2937" Foreground="#FCA5A5" BorderThickness="0" />
                    </StackPanel>
                    <StackPanel Margin="12,0">
                        <TextBlock Text="WORKSPACE" FontSize="10" FontWeight="Bold" Foreground="#64748B" Margin="12,0,0,8" />
                        <Button Content="Ringkasan" Tag="home" Click="NavigationButton_Click" HorizontalContentAlignment="Left" Background="#312E81" Foreground="White" BorderThickness="0" Margin="0,2" />
                        <Button Content="Billing" Tag="billing" Click="NavigationButton_Click" HorizontalContentAlignment="Left" Background="Transparent" Foreground="#CBD5E1" BorderThickness="0" Margin="0,2" />
                        <Button Content="Router &amp; MikroTik" Tag="routers" Click="NavigationButton_Click" HorizontalContentAlignment="Left" Background="Transparent" Foreground="#CBD5E1" BorderThickness="0" Margin="0,2" />
                        <Button Content="OLT / Fiber" Tag="olts" Click="NavigationButton_Click" HorizontalContentAlignment="Left" Background="Transparent" Foreground="#CBD5E1" BorderThickness="0" Margin="0,2" />
                    </StackPanel>
                </DockPanel>
            </Border>
            <Grid Grid.Column="1">
                <Grid.RowDefinitions><RowDefinition Height="78" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <Border Grid.Row="0" Background="White" BorderBrush="#E5EAF1" BorderThickness="0,0,0,1">
                    <DockPanel Margin="28,0">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="PageTitle" Text="Ringkasan" FontSize="20" FontWeight="Bold" Foreground="{StaticResource InkBrush}" />
                            <TextBlock x:Name="OrganizationLabel" Text="Menghubungkan..." FontSize="12" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0" />
                        </StackPanel>
                        <TextBlock x:Name="UserLabel" DockPanel.Dock="Right" VerticalAlignment="Center" Foreground="{StaticResource InkBrush}" FontWeight="SemiBold" />
                    </DockPanel>
                </Border>
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                    <Grid Margin="28">
                        <StackPanel>
                            <TextBlock x:Name="PageHeading" Text="Selamat datang" FontSize="27" FontWeight="Bold" Foreground="{StaticResource InkBrush}" />
                            <TextBlock x:Name="PageDescription" Text="Data operasional BAJAMA dari server Anda." FontSize="14" Foreground="{StaticResource MutedBrush}" Margin="0,5,0,22" />
                            <TextBlock x:Name="PageMessage" TextWrapping="Wrap" Foreground="#B45309" Margin="0,0,0,12" />
                            <WrapPanel x:Name="ContentCards" />
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Window>
